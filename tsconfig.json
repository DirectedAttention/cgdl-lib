{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "**/*.spec.ts", "dist", "node_modules"]
}

