{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "**/*.spec.ts", "dist", "node_modules"]
}
