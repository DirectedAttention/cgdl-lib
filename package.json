{
  "name": "cgdl-lib",
  "version": "0.2.1",
  "type": "module",
  "private": false,
  "description": "CGDL Library — TypeScript parser and graph builder for Context Graph Description Language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DirectedAttention/cgdl-lib.git"
  },
  "bugs": {
    "url": "https://github.com/DirectedAttention/cgdl-lib/issues"
  },
  "homepage": "https://github.com/DirectedAttention/cgdl-lib#readme",
  "keywords": [
    "cgdl",
    "directed-graph",
    "parser",
    "knowledge-graph",
    "incremental-parser",
    "text-format"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "clean": "rmdir /s /q dist 2>nul || exit /b 0",
    "prepublishOnly": "npm run clean && npm test && npm run build"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
